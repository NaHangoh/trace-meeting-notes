# 비밀값은 비워 둔다. 나머지는 기본값이다. 실제 값은 .env에 넣고 커밋하지 않는다.

# 사용할 LLM 구현: openai-compatible | fixture (SPEC F2, ADR 0002)
APP_LLM_PROVIDER=openai-compatible

# OpenAI 호환 실행기 (기본 llama-server, 127.0.0.1에서만). Ollama를 쓸 때는 주소와 모델만 바꾼다
APP_LLM_BASE_URL=http://127.0.0.1:8081/v1
APP_LLM_MODEL=qwen3-8b

# 실행기 API 키 (llama-server --api-key와 같은 값)
LLM_API_KEY=

# Claude API는 eval 비교 단계에서 추가한다 (ADR 0002)
