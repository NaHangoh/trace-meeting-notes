# 기본: 텍스트는 LF로 통일
* text=auto eol=lf

# Windows 스크립트만 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Gradle 래퍼 스크립트는 LF 고정
gradlew text eol=lf

# 바이너리
